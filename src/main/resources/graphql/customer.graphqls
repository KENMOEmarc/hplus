"""A customer of H+ Sport."""
type Customer {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    phoneNumber: String!
    address: String!
    city: String!
    state: String!
    zipCode: String!
}

type Query {
    "All customers."
    getAllCustomers: [Customer!]!

    "A customer by id. Fails with a NOT_FOUND error if it does not exist."
    getCustomerById(id: ID!): Customer

    "A customer by email (case-insensitive). Fails with a NOT_FOUND error if it does not exist."
    getCustomerByEmail(email: String!): Customer

    "Customers whose first name matches, ignoring case."
    getCustomersByFirstName(firstName: String!): [Customer!]!

    "Customers whose last name matches, ignoring case."
    getCustomersByLastName(lastName: String!): [Customer!]!

    "Customers who live in the specified city, ignoring case."
    getCustomersByCity(city: String!): [Customer!]!

    "Customers who live in the specified state, ignoring case."
    getCustomersByState(state: String!): [Customer!]!
}
