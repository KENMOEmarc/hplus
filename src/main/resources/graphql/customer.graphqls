"""A customer of H+ Sport."""
type Customer {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    phoneNumber: String!
    address: String!
    city: String!
    state: String!
    zipCode: String!
}

type Query {
    "All customers."
    getAllCustomers: [Customer!]!

    "A customer by id. Fails with a NOT_FOUND error if it does not exist."
    getCustomerById(id: ID!): Customer

    "A customer by email (case-insensitive). Fails with a NOT_FOUND error if it does not exist."
    getCustomerByEmail(email: String!): Customer
}
